@page
@model LogoutModel
@{
    ViewData["Title"] = "Log out";
}

<div class="min-h-screen bg-cover bg-center flex justify-center items-center"
     style="background-image: url('YOUR_BACKGROUND_IMAGE_URL_HERE');">
     <div class="w-full max-w-md p-8 bg-white bg-opacity-90 backdrop-blur-sm shadow-xl rounded-xl">
         <h2 class="text-3xl font-bold text-center text-gray-800 mb-6">@ViewData["Title"]</h2>

         <p class="text-gray-700 text-center mb-6">
             Are you sure you want to log out?
         </p>

         <form class="flex justify-center" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
             <button type="submit" class="py-2 px-6 bg-red-600 text-white font-bold rounded-md hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500">
                 Log out
             </button>
         </form>
     </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}