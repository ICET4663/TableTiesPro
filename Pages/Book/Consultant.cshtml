@page
@model TableTies.Pages.Book.ConsultantModel
@{
    ViewData["Title"] = "Book a Consultant";
}

@* Add Tailwind CSS and Fonts CDNs *@
<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&display=swap" rel="stylesheet">

@* Optional: Local styles if not in _Layout.cshtml *@
<style>
     /* Example if you use a class defined in _Layout.cshtml's style */
    .page-title {
         font-family: 'Playfair Display', serif; /* Use font added in _Layout or locally */
    }
</style>

@* Use Tailwind classes for layout and styling *@
<div class="container mx-auto px-4 py-6 sm:py-8 max-w-2xl"> @* Responsive container with padding and max-width *@

    @* Header - Use Tailwind classes and potentially the custom font class *@
    <h1 class="text-2xl sm:text-4xl font-bold text-purple-600 mb-6 sm:mb-8 text-center page-title">@ViewData["Title"]</h1> @* Responsive size, color, centering, and custom font class *@

    @* Display status messages from TempData *@
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        @* Using Tailwind classes for alert styling *@
        <div class="bg-purple-100 border border-purple-400 text-purple-700 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline">@Model.StatusMessage</span>
        </div>
    }

    @* --- Consultant Booking Form --- *@
    @* Using Tailwind classes for form styling *@
    <div class="mb-8 p-4 sm:p-6 bg-white rounded-lg shadow-md"> @* Responsive container for the form *@
        <h2 class="text-xl sm:text-2xl font-semibold text-gray-800 mb-4">Book a Consultant</h2> @* Form specific heading *@
        <form method="post" class="space-y-4 sm:space-y-6"> @* Added spacing between form elements *@

            @* Validation Summary: Displays non-field-specific errors *@
            @* Using Tailwind classes for error styling *@
            <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm mb-4" role="alert"></div> @* Red text for validation errors *@

            @* Consultant Dropdown *@
            <div>
                <label asp-for="Input.SelectedConsultantId" class="block text-gray-700 text-sm font-bold mb-2 hover:text-purple-600 transition-colors duration-200">
                    <span class="flex items-center">
                        <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M6 6V5a3 3 0 013-3h2a3 3 0 013 3v1h2a2 2 0 012 2v3.57A22.952 22.952 0 0110 13a22.95 22.95 0 01-8-1.43V8a2 2 0 012-2h2zm2-1a1 1 0 011-1h2a1 1 0 011 1v1H8V5zm1 5a1 1 0 011-1h.01a1 1 0 110 2H10a1 1 0 01-1-1z" clip-rule="evenodd"/>
                            <path d="M2 13.692V16a2 2 0 002 2h12a2 2 0 002-2v-2.308A24.974 24.974 0 0110 15c-2.796 0-5.487-.46-8-1.308z"/>
                        </svg>
                        Consultant
                    </span>
                </label>
                <select asp-for="Input.SelectedConsultantId" class="shadow appearance-none border rounded w-full py-3 px-4 text-gray-700 leading-tight focus:outline-none focus:shadow-outline focus:ring-2 focus:ring-purple-500 hover:border-purple-400 transition-all duration-200"
                         asp-items="Model.ConsultantsList">
                    <option value="">--- Select Consultant ---</option>
                </select>
                <span asp-validation-for="Input.SelectedConsultantId" class="text-red-500 text-xs italic mt-1"></span>
            </div>

            @* Date Selection *@
            <div>
                <label asp-for="Input.BookingDate" class="block text-gray-700 text-sm font-bold mb-2 hover:text-purple-600 transition-colors duration-200">
                    <span class="flex items-center">
                        <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/>
                        </svg>
                        Booking Date
                    </span>
                </label>
                <input asp-for="Input.BookingDate" type="date" class="shadow appearance-none border rounded w-full py-3 px-4 text-gray-700 leading-tight focus:outline-none focus:shadow-outline focus:ring-2 focus:ring-purple-500 hover:border-purple-400 transition-all duration-200" />
                <span asp-validation-for="Input.BookingDate" class="text-red-500 text-xs italic mt-1"></span>
            </div>

            @* Time Selection *@
            <div>
                <label asp-for="Input.StartTime" class="block text-gray-700 text-sm font-bold mb-2 hover:text-purple-600 transition-colors duration-200">
                    <span class="flex items-center">
                        <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
                        </svg>
                        Start Time
                    </span>
                </label>
                <input asp-for="Input.StartTime" type="time" class="shadow appearance-none border rounded w-full py-3 px-4 text-gray-700 leading-tight focus:outline-none focus:shadow-outline focus:ring-2 focus:ring-purple-500 hover:border-purple-400 transition-all duration-200" />
                <span asp-validation-for="Input.StartTime" class="text-red-500 text-xs italic mt-1"></span>
            </div>

            @* Duration Selection *@
            <div>
                <label asp-for="Input.DurationMinutes" class="block text-gray-700 text-sm font-bold mb-2 hover:text-purple-600 transition-colors duration-200">
                    <span class="flex items-center">
                        <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
                        </svg>
                        Duration (Minutes)
                    </span>
                </label>
                <input asp-for="Input.DurationMinutes" type="number" min="15" step="15" class="shadow appearance-none border rounded w-full py-3 px-4 text-gray-700 leading-tight focus:outline-none focus:shadow-outline focus:ring-2 focus:ring-purple-500 hover:border-purple-400 transition-all duration-200" placeholder="e.g., 60" />
                <span asp-validation-for="Input.DurationMinutes" class="text-red-500 text-xs italic mt-1"></span>
            </div>

            @* Details/Questions *@
            <div>
                <label asp-for="Input.Details" class="block text-gray-700 text-sm font-bold mb-2 hover:text-purple-600 transition-colors duration-200">
                    <span class="flex items-center">
                        <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
                        </svg>
                        Details / Questions
                    </span>
                </label>
                <textarea asp-for="Input.Details" rows="4" class="shadow appearance-none border rounded w-full py-3 px-4 text-gray-700 leading-tight focus:outline-none focus:shadow-outline focus:ring-2 focus:ring-purple-500 hover:border-purple-400 transition-all duration-200" placeholder="Please describe what you need help with..."></textarea>
                <span asp-validation-for="Input.Details" class="text-red-500 text-xs italic mt-1"></span>
            </div>

            @* Submit Button *@
            <div class="flex flex-col sm:flex-row items-center justify-between space-y-3 sm:space-y-0 sm:space-x-4">
                <button type="submit" class="w-full sm:w-auto bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-700 hover:to-pink-700 text-white font-bold py-3 px-6 rounded-lg focus:outline-none focus:shadow-outline transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-xl">
                    <span class="flex items-center">
                        <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                        </svg>
                        Book Consultant
                    </span>
                </button>
                <a asp-page="/Index" class="w-full sm:w-auto text-center bg-gray-500 hover:bg-gray-600 text-white font-bold py-3 px-6 rounded-lg focus:outline-none focus:shadow-outline transition-all duration-300 transform hover:scale-105">
                    <span class="flex items-center justify-center">
                        <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
                        </svg>
                        Cancel
                    </span>
                </a>
            </div>
        </form>
    </div>

    @* --- Consultant List Display --- *@
    @if (Model.Consultants != null && Model.Consultants.Any())
    {
        <div class="p-4 sm:p-6 bg-white rounded-lg shadow-md">
            <h2 class="text-xl sm:text-2xl font-semibold text-gray-800 mb-4">Available Consultants</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                @foreach (var consultant in Model.Consultants)
                {
                    <div class="border rounded-lg p-4 hover:shadow-lg transition-shadow duration-200">
                        <h3 class="text-lg font-semibold text-gray-800 mb-2">@consultant.Name</h3>
                        <p class="text-gray-600 text-sm mb-2"><strong>Specialty:</strong> @consultant.Specialty</p>
                        <p class="text-gray-600 text-sm"><strong>ID:</strong> @consultant.Id</p>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
