@page
@model TableTies.Pages.Book.MyBookingsModel
@{
    ViewData["Title"] = "My Bookings";
}

@* Add Tailwind CSS and Fonts CDNs *@
<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&display=swap" rel="stylesheet">

<style>
    .page-title {
        font-family: 'Playfair Display', serif;
    }
</style>

<div class="container mx-auto px-4 py-6 sm:py-8 max-w-6xl">

    @* Status Message Display *@
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="bg-blue-100 border border-blue-400 text-blue-700 px-4 py-3 rounded relative mb-6" role="alert">
            <span class="block sm:inline">@Model.StatusMessage</span>
        </div>
    }

    <h1 class="text-2xl sm:text-3xl font-bold text-gray-800 mb-6 sm:mb-8 text-center page-title">@ViewData["Title"]</h1>

    <div class="space-y-6 lg:space-y-8">
        @* Restaurant Bookings Section *@
        <div class="bg-white rounded-lg shadow-md overflow-hidden">
            <div class="bg-blue-600 text-white p-4">
                <h2 class="text-xl font-semibold">Restaurant Bookings</h2>
            </div>
            <div class="p-4 sm:p-6">
                @if (Model.RestaurantBookings.Any())
                {
                    <div class="space-y-4">
                        @foreach (var booking in Model.RestaurantBookings)
                        {
                            <div class="border rounded-lg p-4 hover:shadow-lg transition-shadow duration-200">
                                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-3">
                                    <h3 class="text-lg font-semibold text-gray-800">Booking #@booking.Id</h3>
                                    <span class="inline-block px-3 py-1 text-xs font-semibold rounded-full @(booking.CancelledAt.HasValue ? "bg-red-100 text-red-800" : "bg-green-100 text-green-800")">
                                        @(booking.CancelledAt.HasValue ? "Cancelled" : "Active")
                                    </span>
                                </div>
                                
                                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 text-sm">
                                    <div>
                                        <span class="font-semibold text-gray-600">Date:</span>
                                        <span class="text-gray-800 ml-1">@booking.BookingDateTime.ToShortDateString()</span>
                                    </div>
                                    <div>
                                        <span class="font-semibold text-gray-600">Time:</span>
                                        <span class="text-gray-800 ml-1">@booking.BookingDateTime.ToShortTimeString()</span>
                                    </div>
                                    <div>
                                        <span class="font-semibold text-gray-600">Guests:</span>
                                        <span class="text-gray-800 ml-1">@booking.NumberOfGuests</span>
                                    </div>
                                    <div>
                                        <span class="font-semibold text-gray-600">Restaurant:</span>
                                        <span class="text-gray-800 ml-1">@booking.Restaurant?.Name</span>
                                    </div>
                                    <div>
                                        <span class="font-semibold text-gray-600">Table:</span>
                                        <span class="text-gray-800 ml-1">@booking.Table?.TableName</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-8">
                        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                        </svg>
                        <p class="mt-2 text-gray-600">No restaurant bookings found.</p>
                    </div>
                }
            </div>
        </div>

        @* Consultant Bookings Section *@
        <div class="bg-white rounded-lg shadow-md overflow-hidden">
            <div class="bg-purple-600 text-white p-4">
                <h2 class="text-xl font-semibold">Consultant Bookings</h2>
            </div>
            <div class="p-4 sm:p-6">
                @if (Model.ConsultantBookings.Any())
                {
                    <div class="space-y-4">
                        @foreach (var booking in Model.ConsultantBookings)
                        {
                            <div class="border rounded-lg p-4 hover:shadow-lg transition-shadow duration-200">
                                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-3">
                                    <h3 class="text-lg font-semibold text-gray-800">Booking #@booking.Id</h3>
                                    <span class="inline-block px-3 py-1 text-xs font-semibold rounded-full @(booking.CancelledDateTime.HasValue ? "bg-red-100 text-red-800" : "bg-green-100 text-green-800")">
                                        @(booking.CancelledDateTime.HasValue ? "Cancelled" : "Active")
                                    </span>
                                </div>
                                
                                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 text-sm">
                                    <div>
                                        <span class="font-semibold text-gray-600">Date:</span>
                                        <span class="text-gray-800 ml-1">@booking.BookingDateTime.ToShortDateString()</span>
                                    </div>
                                    <div>
                                        <span class="font-semibold text-gray-600">Time:</span>
                                        <span class="text-gray-800 ml-1">@booking.BookingDateTime.ToShortTimeString()</span>
                                    </div>
                                    <div>
                                        <span class="font-semibold text-gray-600">Duration:</span>
                                        <span class="text-gray-800 ml-1">@booking.Duration</span>
                                    </div>
                                    <div>
                                        <span class="font-semibold text-gray-600">Consultant:</span>
                                        <span class="text-gray-800 ml-1">@booking.Consultant?.Name</span>
                                    </div>
                                    <div>
                                        <span class="font-semibold text-gray-600">Specialty:</span>
                                        <span class="text-gray-800 ml-1">@booking.Consultant?.Specialty</span>
                                    </div>
                                </div>
                                
                                @if (!string.IsNullOrEmpty(booking.Details))
                                {
                                    <div class="mt-3 pt-3 border-t border-gray-200">
                                        <span class="font-semibold text-gray-600 text-sm">Details:</span>
                                        <p class="text-gray-800 text-sm mt-1">@booking.Details</p>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-8">
                        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                        </svg>
                        <p class="mt-2 text-gray-600">No consultant bookings found.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    @* Action Buttons *@
    <div class="mt-8 flex flex-col sm:flex-row justify-center space-y-3 sm:space-y-0 sm:space-x-4">
        <a href="/Book/Restaurant" class="w-full sm:w-auto text-center bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-lg transition-colors duration-200">
            Book Restaurant
        </a>
        <a href="/Book/Consultant" class="w-full sm:w-auto text-center bg-purple-600 hover:bg-purple-700 text-white font-bold py-3 px-6 rounded-lg transition-colors duration-200">
            Book Consultant
        </a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
