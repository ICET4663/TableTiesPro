@page
@model IndexModel
@{
    ViewData["Title"] = "TableTies - Seamless Space Booking";
}

@using Microsoft.AspNetCore.Identity
@using TableTies.Models
@* SignInManager removed since authentication is disabled *@
@* @inject SignInManager<ApplicationUser> SignInUser *@

<div class="relative min-h-screen bg-gradient-to-br from-indigo-50 to-blue-200 overflow-hidden">
    <div class="absolute inset-0 opacity-10 pointer-events-none">
        <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" class="absolute">
            <defs>
                <pattern id="pattern" x="0" y="0" width="100" height="100" patternUnits="userSpaceOnUse">
                    <path d="M0 0 L100 0 L0 100 Z" fill="rgba(59,130,246,0.05)" />
                    <path d="M100 0 L0 100 L100 100 Z" fill="rgba(99,102,241,0.05)" />
                </pattern>
            </defs>
            <rect width="100%" height="100%" fill="url(#pattern)" />
        </svg>
    </div>

    <div class="relative z-10 container mx-auto px-4 py-8 sm:py-12 lg:py-16 flex items-center justify-center min-h-screen">
        <div class="grid lg:grid-cols-2 gap-8 lg:gap-16 items-center max-w-6xl w-full bg-white/90 backdrop-blur-xl rounded-2xl lg:rounded-3xl shadow-2xl lg:shadow-3xl overflow-hidden border border-white/30 hover:shadow-3xl transition-all duration-700">
            <div class="p-6 sm:p-8 lg:p-12 space-y-6 lg:space-y-10">
                <div>
                    <div class="flex items-center mb-4">
                        <div class="w-12 sm:w-16 h-1 bg-blue-600 mr-3 sm:mr-4 rounded-full"></div>
                        <span class="text-xs sm:text-sm uppercase tracking-wide text-blue-700 font-semibold">TableTies Experience</span>
                    </div>
                    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-gray-900 mb-4 sm:mb-6 leading-tight animate-pulse">
                        Revolutionize <br/>
                        <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-purple-600 hover:to-pink-600 transition-all duration-500">Space Booking</span>
                    </h1>
                    <p class="text-base sm:text-lg lg:text-xl text-gray-600 mb-6 sm:mb-8 leading-relaxed hover:text-gray-700 transition-colors duration-300">
                        Transform your booking experience with intelligent, instant reservations tailored to your needs.
                        <br/><span class="text-sm text-blue-600 font-semibold">✨ No login required • Instant confirmation • 24/7 availability</span>
                    </p>
                </div>

                <div class="space-y-4 sm:space-y-5">
                    @* Since authentication is disabled, always show booking button *@
                    <a asp-page="/Book/Restaurant"
                       class="group w-full block text-center 
                              bg-gradient-to-r from-blue-600 to-indigo-700 text-white 
                              font-bold py-3 sm:py-4 px-4 sm:px-6 rounded-xl 
                              hover:from-blue-700 hover:to-indigo-800 
                              transition-all duration-500 ease-in-out 
                              transform hover:scale-105 hover:rotate-1
                              shadow-lg hover:shadow-2xl 
                              relative overflow-hidden text-sm sm:text-base
                              before:absolute before:inset-0 before:bg-gradient-to-r before:from-transparent before:to-white/20 before:translate-x-[-100%] group-hover:before:translate-x-[100%] before:transition-transform before:duration-700">
                        <span class="relative z-10 flex items-center justify-center">
                            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M10 2a6 6 0 00-6 6v3.586l-.707.707A1 1 0 004 14h12a1 1 0 00.707-1.707L16 11.586V8a6 6 0 00-6-6z"/>
                                <path d="M10 18a3 3 0 01-3-3h6a3 3 0 01-3 3z"/>
                            </svg>
                            Book Restaurant
                        </span>
                    </a>
                    
                    <a asp-page="/Book/Consultant"
                       class="group w-full block text-center 
                              bg-gradient-to-r from-purple-600 to-pink-700 text-white 
                              font-bold py-3 sm:py-4 px-4 sm:px-6 rounded-xl 
                              hover:from-purple-700 hover:to-pink-800 
                              transition-all duration-500 ease-in-out 
                              transform hover:scale-105 hover:rotate-1
                              shadow-lg hover:shadow-2xl 
                              relative overflow-hidden text-sm sm:text-base
                              before:absolute before:inset-0 before:bg-gradient-to-r before:from-transparent before:to-white/20 before:translate-x-[-100%] group-hover:before:translate-x-[100%] before:transition-transform before:duration-700">
                        <span class="relative z-10 flex items-center justify-center">
                            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M6 6V5a3 3 0 013-3h2a3 3 0 013 3v1h2a2 2 0 012 2v3.57A22.952 22.952 0 0110 13a22.95 22.95 0 01-8-1.43V8a2 2 0 012-2h2zm2-1a1 1 0 011-1h2a1 1 0 011 1v1H8V5zm1 5a1 1 0 011-1h.01a1 1 0 110 2H10a1 1 0 01-1-1z" clip-rule="evenodd"/>
                                <path d="M2 13.692V16a2 2 0 002 2h12a2 2 0 002-2v-2.308A24.974 24.974 0 0110 15c-2.796 0-5.487-.46-8-1.308z"/>
                            </svg>
                            Book Consultant
                        </span>
                    </a>
                </div>

                <div class="hidden sm:block">
                    <div class="flex items-center space-x-8 text-gray-600">
                        <div class="text-center transform hover:scale-110 transition-transform duration-300">
                            <div class="text-2xl font-bold text-blue-600">500+</div>
                            <div class="text-xs sm:text-sm">Restaurants</div>
                        </div>
                        <div class="text-center transform hover:scale-110 transition-transform duration-300">
                            <div class="text-2xl font-bold text-purple-600">100+</div>
                            <div class="text-xs sm:text-sm">Consultants</div>
                        </div>
                        <div class="text-center transform hover:scale-110 transition-transform duration-300">
                            <div class="text-2xl font-bold text-green-600">24/7</div>
                            <div class="text-xs sm:text-sm">Support</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="hidden lg:block relative">
                <div class="absolute inset-0 bg-gradient-to-r from-blue-500 to-indigo-700 opacity-10 rounded-tr-3xl rounded-br-3xl"></div>
                <img src="https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1170&q=80"
                     alt="TableTies Space Booking"
                     class="w-full h-full object-cover rounded-tr-3xl rounded-br-3xl transform transition-transform duration-500 hover:scale-105 hover:brightness-90" />
            </div>
        </div>
    </div>
</div>

@* Mobile stats section *@
<div class="sm:hidden bg-white/80 backdrop-blur-lg py-6">
    <div class="container mx-auto px-4">
        <div class="flex justify-around text-gray-600">
            <div class="text-center">
                <div class="text-xl font-bold text-blue-600">500+</div>
                <div class="text-xs">Restaurants</div>
            </div>
            <div class="text-center">
                <div class="text-xl font-bold text-purple-600">100+</div>
                <div class="text-xs">Consultants</div>
            </div>
            <div class="text-center">
                <div class="text-xl font-bold text-green-600">24/7</div>
                <div class="text-xs">Support</div>
            </div>
        </div>
    </div>
</div>
