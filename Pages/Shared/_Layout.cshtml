<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TableTies</title> @* Consistent App Name *@

    @* Using CDN for development/simplicity. Consider a build process for production. *@
    <script src="https://cdn.tailwindcss.com"></script>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />

    @* Ensure site.css contains only custom styles, no Bootstrap imports *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        /* Minimal base styles, Tailwind utility classes handle most things */
        html, body {
            /* Tailwind min-h-screen handles height */
            margin: 0;
            font-family: 'Inter', sans-serif;
        }
    </style>
</head>
@* Apply background image and flex column layout directly to the body *@
<body class="min-h-screen flex flex-col relative bg-cover bg-center bg-no-repeat"
      style="background-image: url('/images/background.jpg');">

    @* Background Overlay - absolute positioned above the body background, below content *@
    <div class="absolute inset-0 bg-black bg-opacity-30 z-0"></div>

    @* Header - positioned relative z-10 to be above the overlay *@
    <header class="relative z-10 bg-white bg-opacity-90 shadow-sm">
        <nav class="container mx-auto px-4 py-3">
            <div class="flex justify-between items-center">
                <a class="text-lg sm:text-xl font-bold text-gray-800" asp-area="" asp-page="/Index">TableTies</a>
                
                @* Desktop Navigation *@
                <div class="hidden md:flex items-center space-x-4">
                    <a class="text-gray-600 hover:text-gray-900 transition-colors" asp-area="" asp-page="/Index">Home</a>
                    <a class="text-gray-600 hover:text-gray-900 transition-colors" asp-area="" asp-page="/Book/Restaurant">Restaurants</a>
                    <a class="text-gray-600 hover:text-gray-900 transition-colors" asp-area="" asp-page="/Book/Consultant">Consultants</a>
                    <a class="text-gray-600 hover:text-gray-900 transition-colors" asp-area="" asp-page="/Book/MyBookings">My Bookings</a>
                    <partial name="_LoginPartial" />
                </div>

                @* Mobile menu button *@
                <button id="mobile-menu-button" class="md:hidden p-2 rounded-md text-gray-600 hover:text-gray-900 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
            </div>

            @* Mobile Navigation *@
            <div id="mobile-menu" class="hidden md:hidden mt-4 pb-4 border-t border-gray-200">
                <div class="flex flex-col space-y-3 pt-4">
                    <a class="text-gray-600 hover:text-gray-900 transition-colors px-2 py-1" asp-area="" asp-page="/Index">Home</a>
                    <a class="text-gray-600 hover:text-gray-900 transition-colors px-2 py-1" asp-area="" asp-page="/Book/Restaurant">Restaurants</a>
                    <a class="text-gray-600 hover:text-gray-900 transition-colors px-2 py-1" asp-area="" asp-page="/Book/Consultant">Consultants</a>
                    <a class="text-gray-600 hover:text-gray-900 transition-colors px-2 py-1" asp-area="" asp-page="/Book/MyBookings">My Bookings</a>
                    <div class="px-2 py-1">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    @* Main Content - positioned relative z-10, flex-grow to push footer down *@
    <main role="main" class="relative z-10 flex-grow container mx-auto px-4 py-8 text-gray-900">
        @RenderBody()
    </main>

    @* Footer - positioned relative z-10 *@
    <footer class="relative z-10 bg-white bg-opacity-90 shadow-sm mt-8">
        <div class="container mx-auto px-4 py-6">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div>
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">TableTies</h3>
                    <p class="text-gray-600 text-sm">Your seamless booking experience for restaurants and consultants.</p>
                </div>
                <div>
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">Quick Links</h3>
                    <div class="space-y-2">
                        <a class="block text-gray-600 hover:text-gray-900 text-sm transition-colors" asp-area="" asp-page="/Book/Restaurant">Book Restaurant</a>
                        <a class="block text-gray-600 hover:text-gray-900 text-sm transition-colors" asp-area="" asp-page="/Book/Consultant">Book Consultant</a>
                        <a class="block text-gray-600 hover:text-gray-900 text-sm transition-colors" asp-area="" asp-page="/Book/MyBookings">My Bookings</a>
                    </div>
                </div>
                <div>
                    <h3 class="text-lg font-semibold text-gray-800 mb-3">Contact</h3>
                    <p class="text-gray-600 text-sm">Email: support@tableties.com</p>
                    <p class="text-gray-600 text-sm">Phone: 1-800-TABLES</p>
                    <div class="flex space-x-4 mt-3">
                        <a href="#" class="text-gray-600 hover:text-blue-600 transition-colors">
                            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                        </a>
                        <a href="#" class="text-gray-600 hover:text-blue-400 transition-colors">
                            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/></svg>
                        </a>
                        <a href="#" class="text-gray-600 hover:text-pink-600 transition-colors">
                            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zM5.838 12a6.162 6.162 0 1112.324 0 6.162 6.162 0 01-12.324 0zM12 16a4 4 0 110-8 4 4 0 010 8zm4.965-10.405a1.44 1.44 0 112.881.001 1.44 1.44 0 01-2.881-.001z"/></svg>
                        </a>
                    </div>
                </div>
            </div>
            <div class="border-t border-gray-200 mt-6 pt-4 text-center">
                <p class="text-gray-600 text-sm">&copy; 2024 TableTies. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script>
        // Mobile menu toggle
        document.getElementById('mobile-menu-button').addEventListener('click', function() {
            const menu = document.getElementById('mobile-menu');
            menu.classList.toggle('hidden');
        });

        // Close mobile menu when clicking on links
        document.querySelectorAll('#mobile-menu a').forEach(link => {
            link.addEventListener('click', function() {
                document.getElementById('mobile-menu').classList.add('hidden');
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
